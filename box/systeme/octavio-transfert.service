[Unit]
Description=Octavio box: file transfer page over the USB-C cable (http://octavio.local)
After=network.target

[Service]
User=octavio
ExecStart=/usr/bin/python3 /home/octavio/plugins/box/systeme/transfert.py --root /home/octavio/octavio --port 8080
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
